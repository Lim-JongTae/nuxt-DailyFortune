const files = [
  'server/utils/iching/hexagrams1_8.ts',
  'server/utils/iching/hexagrams9_16.ts',
  'server/utils/iching/hexagrams17_24.ts',
  'server/utils/iching/hexagrams25_32.ts',
  'server/utils/iching/hexagrams33_40.ts',
  'server/utils/iching/hexagrams41_48.ts',
  'server/utils/iching/hexagrams49_56.ts',
  'server/utils/iching/hexagrams57_64.ts'
]

// 단정어 순화 맵
const assertiveReplacements: [RegExp, string][] = [
  [/반드시\s*성공합니다/g, '성공할 가능성이 매우 높습니다'],
  [/반드시\s*이겨냅니다/g, '충분히 이겨낼 수 있습니다'],
  [/반드시\s*망합니다/g, '큰 손실을 입을 위험이 큽니다'],
  [/반드시\s*패배합니다/g, '어려움에 직면하기 쉽습니다'],
  [/절대\s*금물입니다/g, '가급적 삼가는 것이 좋습니다'],
  [/절대\s*하지 마십시오/g, '신중히 자제하는 것이 현명합니다'],
  [/절대로\s*안 됩니다/g, '무리하게 진행하지 않는 편이 이롭습니다'],
  [/무조건\s*피하십시오/g, '가급적 피하는 것이 안전합니다'],
  [/무조건\s*따르십시오/g, '순리에 따르는 것이 권장됩니다']
]

for (const relPath of files) {
  const fullPath = path.resolve(relPath)
  let content = fs.readFileSync(fullPath, 'utf-8')

  // 1. health 필드 전면 교체
  const healthRegex = /(\s*(\d+):\s*\{[\s\S]*?health:\s*')([\s\S]*?)('[\s\S]*?lineOverview:)/g
  content = content.replace(healthRegex, (match, prefix, idStr, oldHealth, suffix) => {
    const id = parseInt(idStr, 10)
    const newHealth = refinedHealthByHex[id] || oldHealth
    return `${prefix}${newHealth}${suffix}`
  })

  // 2. 단정적 어조 완화
  for (const [re, rep] of assertiveReplacements) {
    content = content.replace(re, rep)
  }

  fs.writeFileSync(fullPath, content, 'utf-8')
  console.log(`[완료] ${relPath} 건강 항목 전면 순화 및 단정어 완화 적용`)
}

