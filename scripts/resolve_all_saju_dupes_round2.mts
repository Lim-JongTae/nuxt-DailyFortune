let totalR2 = 0
for (const filePath of groupFiles) {
  let content = fs.readFileSync(filePath, 'utf8')
  let fileR2 = 0

  for (const [code, replacements] of Object.entries(r2Replacements)) {
    const codeBlockRegex = new RegExp(`'${code}':\\s*\\{[\\s\\S]*?\\n  \\}`, 'g')
    content = content.replace(codeBlockRegex, (block) => {
      for (const [oldSent, newSent] of Object.entries(replacements)) {
        if (block.includes(oldSent)) {
          block = block.split(oldSent).join(newSent)
          fileR2++
          totalR2++
        }
      }
      return block
    })
  }

  fs.writeFileSync(filePath, content, 'utf8')
  console.log(`[${path.basename(filePath)}] ${fileR2}개 문장 2차 고유화 완료`)
}

console.log(`\n2차 고유화 총 ${totalR2}개 문장 치환 완료!`)

