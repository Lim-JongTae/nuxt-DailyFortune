    relatedHexagrams: [{ id: 3, name: '3번 수뢰준(水雷屯)', slug: '3' }, { id: 5, name: '5번 수천수(水天需)', slug: '5' }],
    faqList: [{ q: '산수몽 괘에서의 배움의 태도는 무엇인가요?', a: '지혜로운 스승에게 정성 어린 마음으로 배움을 청하고, 의심하여 거듭 물으며 스승을 시험하지 않는 장엄한 자세가 핵심입니다.' }]
  },
  5: {
    guaCi: '需，有孚，光亨，貞吉。利涉大川。',
    tuanZhuan: '需，須也，險在前也。剛健而不陷，其義不困窮矣。',
    tuanExplanation: '앞에 강물이 막혀 위태로우나, 굳건한 내실과 진실된 신뢰를 지니고 때를 여유롭게 기다리면 마침내 큰 강을 건너 형통함을 얻습니다.',
    xiangZhuan: '雲上於天，需；君子以飲食宴樂。',
    xiangLesson: '군자는 구름이 하늘 위로 올라 비가 내리기를 기다리는 모습을 본받아 음식을 즐기고 조급해하지 않는 유유자적의 인내(飲食宴樂)를 다스립니다.',
    xuGuaZhuan: '蒙者蒙也，物之稚也。物稚不可不養也，故受之以需。',
