    relatedHexagrams: [{ id: 63, name: '63번 수화기제(水火旣濟)', slug: '63' }, { id: 1, name: '1번 중천건(乾爲天)', slug: '1' }],
    faqList: [{ q: '주역 64괘의 마지막이 완성이 아닌 미제(未濟)로 끝나는 이유는 무엇인가요?', a: '우주와 세상의 변화는 결코 막을 내리지 않고 끝없이 새로운 순환을 향해 나아간다는 동양 철학의 위대한 진리를 보여줍니다.' }]
  }
}

function getKoreanLineName(nameHanja: string = '', lineNumber: number): string {
  const map: Record<string, string> = {
    '初': '초',
    '上': '상',
    '六': '육',
    '九': '구',
    '二': '이',
    '三': '삼',
    '四': '사',
    '五': '오'
  }
  if (!nameHanja) return `${lineNumber}효`
  return nameHanja.split('').map(char => map[char] || char).join('')
}